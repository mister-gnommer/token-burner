{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest.schema.json",
  "title": "Standupers graph run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "batch",
    "status",
    "performer_ids",
    "paths",
    "workers",
    "counts",
    "surprises",
    "notes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}-[A-Za-z0-9_-]+$"},
    "stage": {"enum": ["calibration", "batch"]},
    "batch": {"type": ["integer", "null"], "minimum": 1, "maximum": 10},
    "status": {
      "enum": ["prepared", "collecting", "extracting", "verifying", "validated", "completed", "blocked", "failed"]
    },
    "performer_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_candidates", "evidence_unreviewed", "evidence", "verification_report"],
      "properties": {
        "source_candidates": {"type": "string", "minLength": 1},
        "evidence_unreviewed": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "verification_report": {"type": "string", "minLength": 1}
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector", "extractor", "verifier"],
      "properties": {
        "collector": {"$ref": "#/$defs/worker"},
        "extractor": {"$ref": "#/$defs/worker"},
        "verifier": {"$ref": "#/$defs/worker"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_candidates", "extracted", "accepted", "uncertain", "rejected"],
      "properties": {
        "source_candidates": {"type": "integer", "minimum": 0},
        "extracted": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "uncertain": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    },
    "surprises": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "calibration"}}},
      "then": {"properties": {"batch": {"type": "null"}}}
    },
    {
      "if": {"properties": {"stage": {"const": "batch"}}},
      "then": {"properties": {"batch": {"type": "integer", "minimum": 1, "maximum": 10}}}
    }
  ],
  "$defs": {
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
